{
  "name": "cf-error-watcher-extension",
  "version": "1.0.0",
  "description": "Cloudflare UI & Worker Error Watcher — Chrome extension popup, built on ReUI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/ui-guard.mjs && node scripts/selfcheck-report.mjs && vite build && node scripts/copy-static.mjs",
    "ui-guard": "node scripts/ui-guard.mjs",
    "typecheck": "tsc --noEmit",
    "selfcheck": "node scripts/selfcheck-report.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/chrome": "^0.0.312",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
