{
  "manifest_version": 3,
  "name": "Cloudflare UI & Worker Error Watcher",
  "version": "1.0.0",
  "description": "Monitors hacolby.workers.dev and hacolby.app for React, Astro island, and library errors, automatically logging them to Cloudflare D1.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Cloudflare Error Watcher"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.hacolby.workers.dev/*",
    "*://*.hacolby.app/*",
    "https://cloudflare-api-mcp.hacolby.workers.dev/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hacolby.workers.dev/*",
        "*://*.hacolby.app/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "content/in-page-tracker.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.hacolby.workers.dev/*",
        "*://*.hacolby.app/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
