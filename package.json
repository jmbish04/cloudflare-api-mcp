{
  "name": "cloudflare-mcp",
  "version": "0.1.0",
  "description": "Authenticated MCP OAuth proxy for Cloudflare API with Astro & Shadcn React",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "astro build && wrangler deploy -c ./wrangler.jsonc dist/server/entry.mjs --assets dist/client",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.1",
    "@astrojs/react": "6.0.2",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@types/node": "^25.0.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.103.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"]
  }
}
