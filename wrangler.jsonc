{
  "name": "cloudflare-api-mcp",
  // SOURCE entry, read by @astrojs/cloudflare 14 (via @cloudflare/vite-plugin),
  // which bundles it into dist/server/entry.mjs. It re-exports the adapter's own
  // fetch handler and adds the CloudflareOps RPC entrypoint. This is NOT the old
  // "main points at build output" mistake that broke astro build - that one is
  // still wrong; pnpm run deploy passes dist/server/entry.mjs on the CLI.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-01-12",
  "compatibility_flags": ["nodejs_compat"],
  // Preview URLs are disabled: Workers Builds preview (non-production) deployments
  // are not reliably compatible with this Worker's runtime/bindings, so their
  // preview URL renders incorrectly. Pinning false also stops a wrangler deploy
  // from re-enabling previews. Production deploys on the main branch are unaffected.
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "UPSTREAM_MCP_URL": "https://mcp.cloudflare.com/mcp"
  },
  "d1_databases": [
    {
      "binding": "CICD_DB",
      "database_name": "cloudflare-api-mcp-cicd",
      "database_id": "19268d0c-576c-44fb-8cda-d342756fa70f",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "3cb4a3cded1141579db392c7712a9f16",
      "remote": true
    },
    {
      "binding": "OAUTH_KV",
      "id": "fe5df5570a674ab28a0d893a34bcfe0b",
      "remote": true
    }
  ],
  "secrets_store_secrets": [
    {
      // User-scoped Cloudflare token. MEASURED 2026-09-10: the account-scoped
      // CLOUDFLARE_WRANGLER_API_TOKEN is refused by /accounts/{id}/builds/* with
      // 401 code 12006 "Invalid token"; this user token returns 200. The Workers
      // Builds API requires "Workers Builds Configuration" on a USER token.
      "binding": "CLOUDFLARE_USER_WRANGLER_API_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_USER_WRANGLER_API_TOKEN"
    },
    {
      // Administering USER API tokens (documented quota: 50 per account; measured
      // 48 in use on 2026-09-30). MEASURED: the wrangler user token CANNOT do this
      // (9109 Unauthorized), and neither can the account token — this credential is
      // the only one that lists/creates/rolls user tokens. Account-owned tokens need
      // no extra binding: CLOUDFLARE_WRANGLER_API_TOKEN already administers those.
      "binding": "CLOUDFLARE_USER_TOKEN_ADMIN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_USER_TOKEN_ADMIN"
    },
    {
      // Read-only use: resolving a repo id and PR metadata for build correlation.
      "binding": "GH_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GH_TOKEN"
    },
    {
      "binding": "WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "WORKER_API_KEY"
    },
    {
      "binding": "CLOUDFLARE_WRANGLER_API_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_WRANGLER_API_TOKEN"
    },
    {
      "binding": "REUI_LICENSE_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "REUI_LICENSE_KEY"
    },
    {
      "binding": "CLOUDFLARE_ACCOUNT_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_ACCOUNT_ID"
    }
  ],
  "dev": {
    "port": 2529
  }
}
