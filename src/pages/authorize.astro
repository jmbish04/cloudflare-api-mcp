---
import Layout from '../layouts/Layout.astro'
import { AuthorizePage } from '../components/AuthorizePage'
import { env } from 'cloudflare:workers'

export const prerender = false

let clientName = 'Claude MCP Client'
let statePayload = ''
let errorMessage = ''

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData()
    const apiKey = formData.get('apiKey')?.toString().trim() ?? ''
    statePayload = formData.get('state')?.toString() ?? ''

    if (!statePayload) {
      errorMessage = 'Missing OAuth session state.'
    } else {
      let oauthReqInfo: {
        clientId?: string
        redirectUri?: string
        state?: string
        responseType?: string
        scope?: string[]
        codeChallenge?: string
        codeChallengeMethod?: string
      }
      try {
        oauthReqInfo = JSON.parse(statePayload)
      } catch {
        errorMessage = 'Invalid session state format.'
        oauthReqInfo = {}
      }

      if (oauthReqInfo && env) {
        const expectedApiKey = await env.WORKER_API_KEY.get()
        if (!expectedApiKey || apiKey !== expectedApiKey) {
          if (oauthReqInfo.clientId && env.OAUTH_KV) {
            const clientJson = await env.OAUTH_KV.get(`client:${oauthReqInfo.clientId}`)
            if (clientJson) {
              const client = JSON.parse(clientJson)
              clientName = client.client_name || oauthReqInfo.clientId
            }
          }
          errorMessage = 'Invalid Worker API Key. Please try again.'
        } else {
          // Direct OAuth code redirect for 1-year persistent grant
          const targetRedirectUri =
            oauthReqInfo.redirectUri || 'https://claude.ai/api/mcp/oauth_callback'
          const redirectUrl = new URL(targetRedirectUri)
          const authCode = `auth_${crypto.randomUUID().replace(/-/g, '')}`

          // Store auth code in KV for /token exchange. The PKCE challenge is
          // carried through so /token can verify the client's code_verifier.
          if (env.OAUTH_KV) {
            await env.OAUTH_KV.put(
              `code:${authCode}`,
              JSON.stringify({
                clientId: oauthReqInfo.clientId,
                redirectUri: targetRedirectUri,
                codeChallenge: oauthReqInfo.codeChallenge,
                codeChallengeMethod: oauthReqInfo.codeChallengeMethod,
                issuedAt: Date.now()
              }),
              { expirationTtl: 600 }
            )
          }

          redirectUrl.searchParams.set('code', authCode)
          if (oauthReqInfo.state) {
            redirectUrl.searchParams.set('state', oauthReqInfo.state)
          }
          return Astro.redirect(redirectUrl.toString(), 302)
        }
      }
    }
  } catch (err) {
    console.error('Error completing authorization:', err)
    errorMessage = 'Failed to complete authorization.'
  }
} else {
  // GET request
  try {
    const params = Astro.url.searchParams
    const clientId = params.get('client_id') || 'claude'
    const redirectUri = params.get('redirect_uri') || 'https://claude.ai/api/mcp/oauth_callback'
    const state = params.get('state') || ''
    const responseType = params.get('response_type') || 'code'
    const scope = (params.get('scope') || 'read write').split(' ').filter(Boolean)
    const codeChallenge = params.get('code_challenge') || ''
    const codeChallengeMethod =
      params.get('code_challenge_method') || (codeChallenge ? 'S256' : '')

    if (env.OAUTH_KV && clientId) {
      const clientJson = await env.OAUTH_KV.get(`client:${clientId}`)
      if (clientJson) {
        const client = JSON.parse(clientJson)
        clientName = client.client_name || clientId
      } else {
        clientName = params.get('client_name') || 'Claude MCP Client'
      }
    } else {
      clientName = params.get('client_name') || 'Claude MCP Client'
    }

    const oauthReqInfo = {
      clientId,
      redirectUri,
      state,
      responseType,
      scope,
      codeChallenge,
      codeChallengeMethod
    }
    statePayload = JSON.stringify(oauthReqInfo)
  } catch (err) {
    console.error('Error parsing auth request:', err)
    errorMessage = 'Invalid authorization request parameters.'
  }
}
---

<Layout title="Authorize Cloudflare MCP">
  <AuthorizePage
    client:load
    clientName={clientName}
    state={statePayload}
    error={errorMessage}
  />
</Layout>
